{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(task --list *)",
      "Bash(task test *)",
      "Bash(task test-short *)",
      "Bash(task test-outline *)",
      "Bash(task lint *)",
      "Bash(task lint-fix *)",
      "Bash(task lint-config *)",
      "Bash(task helm-lint *)",
      "Bash(task lint-values *)",
      "Bash(task manifests *)",
      "Bash(task generate *)",
      "Bash(task generate-helm-docs *)",
      "Bash(task build *)",
      "Bash(task fmt *)",
      "Bash(task vet *)",
      "Bash(task conform *)",
      "Bash(task check-commits *)",
      "Bash(go run ./hack/*)",
      "Bash(go doc *)",
      "Bash(git show 2.3.x*)",
      "Bash(git ls-tree *)",
      "Bash(git grep *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git status *)",
      "Bash(helm lint *)",
      "Bash(helm template *)",
      "Bash(task acceptance-check *)",
      "Bash(task acceptance-inspect *)",
      "Bash(task acceptance-validate)",
      "Bash(task acceptance-validate *)",
      "Bash(task acceptance-setup *)",
      "Bash(task acceptance-apply *)",
      "Bash(task acceptance-delete *)"
    ],
    "ask": [
      "Bash(task *deploy*)",
      "Bash(task *install*)",
      "Bash(task *docker-*)",
      "Bash(task *test-e2e*)",
      "Bash(task run*)",
      "Bash(task * run*)",
      "Bash(task acceptance-cleanup*)",
      "Bash(git rebase)",
      "Bash(git rebase -i*)",
      "Bash(git rebase --interactive*)",
      "Bash(git rebase --autosquash*)",
      "Bash(git rebase --onto*)",
      "Bash(git rebase --root*)",
      "Bash(git rebase --exec*)",
      "Bash(git rebase -x*)",
      "Bash(git rebase origin/*)",
      "Bash(git rebase main*)",
      "Bash(git rebase HEAD*)",
      "Bash(GIT_SEQUENCE_EDITOR=* git rebase*)",
      "Bash(git commit --amend*)",
      "Bash(git commit * --amend*)",
      "Bash(git reset --soft*)",
      "Bash(git reset --mixed*)",
      "Bash(git reset --hard*)",
      "Bash(git reset --keep*)",
      "Bash(git reset --merge*)",
      "Bash(git reset HEAD~*)",
      "Bash(git reset HEAD^*)",
      "Bash(git pull --rebase*)",
      "Bash(git pull -r*)",
      "Bash(git branch -f *)",
      "Bash(git branch --force *)",
      "Bash(git branch -M *)",
      "Bash(git checkout -B *)",
      "Bash(git switch -C *)",
      "Bash(git update-ref *)",
      "Bash(git filter-branch *)",
      "Bash(git filter-repo *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-generated-files.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/confirm-outbound-actions.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/confirm-history-rewrites.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
