{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(task --list *)",
      "Bash(task test *)",
      "Bash(task test-short *)",
      "Bash(task test-outline *)",
      "Bash(task lint *)",
      "Bash(task lint-fix *)",
      "Bash(task lint-config *)",
      "Bash(task helm-lint *)",
      "Bash(task lint-values *)",
      "Bash(task manifests *)",
      "Bash(task generate *)",
      "Bash(task generate-helm-docs *)",
      "Bash(task build *)",
      "Bash(task fmt *)",
      "Bash(task vet *)",
      "Bash(task conform *)",
      "Bash(task check-commits *)",
      "Bash(task lint-hooks *)",
      "Bash(task lint-markdown *)",
      "Bash(task lint-markdown-fix *)",
      "Bash(task release-dry-run *)",
      "Bash(go vet ./*)",
      "Bash(go vet -tags e2e ./*)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr status *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(gh workflow list *)",
      "Bash(gh workflow view *)",
      "Bash(gh release view *)",
      "Bash(gh release list *)",
      "Bash(gh repo view *)",
      "Bash(gh label list *)",
      "Bash(gh search *)",
      "Bash(gh pr edit * --add-label e2e-ready)",
      "Bash(gh pr merge * --disable-auto)",
      "Bash(gh pr comment * --body \"@coderabbitai review\")",
      "Bash(gh pr comment * --body \"@coderabbitai full review\")",
      "Bash(go run ./hack/*)",
      "Bash(go doc *)",
      "Bash(git show 2.3.x*)",
      "Bash(git ls-tree *)",
      "Bash(git grep *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git status *)",
      "Bash(helm lint *)",
      "Bash(helm template *)",
      "Bash(task acceptance-check *)",
      "Bash(task acceptance-inspect *)",
      "Bash(task acceptance-get *)",
      "Bash(task acceptance-validate)",
      "Bash(task acceptance-validate *)",
      "Bash(task acceptance-setup *)",
      "Bash(task acceptance-apply *)",
      "Bash(task acceptance-delete *)"
    ],
    "ask": [
      "Bash(task *deploy*)",
      "Bash(task *install*)",
      "Bash(task *docker-*)",
      "Bash(task *test-e2e*)",
      "Bash(task run*)",
      "Bash(task * run*)",
      "Bash(task acceptance-cleanup*)",
      "Bash(task acceptance-config*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Edit(**/kuik-acceptance-approved)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-generated-files.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/confirm-outbound-actions.sh || exit 2",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
