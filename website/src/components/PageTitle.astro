---
// Custom PageTitle override: renders a version note *under* the page title,
// replacing the one starlight-versions adds through its own PageTitle override.
//
// The site root holds the docs of the latest stable line: its pages get no
// note. A page under a version slug says which version it documents, by the
// `kind` of the version in versions.mjs (see VersionNoteText): the development
// version, not released yet (orange), or an older line (blue).
//
// Overriding PageTitle makes the plugin log a one-line "already defined" warning
// at build and skip its own notice: expected, we render the note ourselves.
import Default from '@astrojs/starlight/components/PageTitle.astro';
import { Icon } from '@astrojs/starlight/components';
import VersionNoteText from './VersionNoteText.astro';
import { versionOf } from '../lib/version.mjs';

const { entry } = Astro.locals.starlightRoute;

const version = versionOf(entry.id);

// Landing pages (the homepage hero / splash) get the Banner note instead.
const isLanding = entry.data.template === 'splash' || Boolean(entry.data.hero);

const showNote = Boolean(version) && !isLanding;
const unreleased = version?.kind === 'unreleased';
---

<Default>
  <slot />
</Default>

{
  showNote && (
    <p class:list={['version-note', { unreleased }]}>
      <Icon name={unreleased ? 'warning' : 'information'} size="1em" />
      <span>
        <VersionNoteText version={version} id={entry.id} />
      </span>
    </p>
  )
}

<style>
  .version-note {
    display: flex;
    border: 1px solid var(--sl-color-blue);
    background-color: var(--sl-color-blue-low);
    color: var(--sl-color-blue-high);
    padding: 0.75em 1em;
    width: max-content;
    max-width: 100%;
    align-items: center;
    gap: 0.75em;
    font-size: var(--sl-text-sm);
    line-height: var(--sl-line-height-headings);
  }

  .version-note.unreleased {
    border-color: var(--sl-color-orange);
    background-color: var(--sl-color-orange-low);
    color: var(--sl-color-orange-high);
  }

  .version-note :global(a),
  .version-note :global(code) {
    color: inherit;
  }

  .version-note :global(code) {
    background-color: transparent;
  }

  .version-note :global(svg) {
    flex-shrink: 0;
  }
</style>
