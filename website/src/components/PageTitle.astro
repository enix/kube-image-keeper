---
// Custom PageTitle override: renders a version notice *under* the page title,
// replacing the one starlight-versions adds through its own PageTitle override.
//
// The site root holds the current docs (v3), the ones for new installs: they
// get no notice. Each archived version (v2.3) is a maintained line for existing
// installs: its pages get a note that says so and links to the same page at the
// root (or the root home when it has no counterpart) and to the upgrade section.
//
// Overriding PageTitle makes the plugin log a one-line "already defined" warning
// at build and skip its own notice: expected, we render the notice ourselves.
import Default from '@astrojs/starlight/components/PageTitle.astro';
import { Icon } from '@astrojs/starlight/components';
import { getCollection } from 'astro:content';
import versionsConfig from 'virtual:starlight-versions-config';

const { entry } = Astro.locals.starlightRoute;

const currentLabel = versionsConfig.current?.label ?? 'the current version';

// Archived-version pages have an id prefixed by the version slug
// (e.g. `2.3/configuration`); current pages do not.
const archived = versionsConfig.versions.find(
  (v) => entry.id === v.slug || entry.id.startsWith(`${v.slug}/`),
);

// Landing pages (the homepage hero / splash) get the Banner notice instead.
const isLanding = entry.data.template === 'splash' || Boolean(entry.data.hero);

const showNote = Boolean(archived) && !isLanding;

// Point the note at the same page at the root, falling back to the root home.
let currentHref = '/';
if (showNote) {
  const docIds = new Set((await getCollection('docs')).map((d) => d.id));
  const barePath = entry.id.slice(archived.slug.length + 1);
  if (barePath && docIds.has(barePath)) currentHref = `/${barePath}/`;
}
---

<Default>
  <slot />
</Default>

{
  showNote && (
    <p class="version-note">
      <Icon name="information" size="1em" />
      <span>
        This documents {archived.label ?? archived.slug}, maintained for existing installs.{' '}
        New installs use <a href={currentHref}>{currentLabel}</a>; see{' '}
        <a href="/installation/#upgrading-from-v2">Upgrading from v2</a>.
      </span>
    </p>
  )
}

<style>
  .version-note {
    display: flex;
    border: 1px solid var(--sl-color-blue);
    background-color: var(--sl-color-blue-low);
    color: var(--sl-color-blue-high);
    padding: 0.75em 1em;
    width: max-content;
    max-width: 100%;
    align-items: center;
    gap: 0.75em;
    font-size: var(--sl-text-sm);
    line-height: var(--sl-line-height-headings);
  }

  .version-note :global(a) {
    color: inherit;
  }

  .version-note :global(svg) {
    flex-shrink: 0;
  }
</style>
