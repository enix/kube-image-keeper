---
// Custom Banner override, 2 jobs:
//   1. Suppress starlight-versions' splash-page VersionBanner ("This content is
//      for vx.y. Switch to the latest version for up-to-date documentation."),
//      which fits neither a line still maintained nor the development version.
//   2. On the landing pages of a version under a slug, which PageTitle's
//      under-title note skips, show the same note as a full-width banner (see
//      VersionNoteText). Root pages get nothing.
//
// Starlight's Default banner is still rendered so per-page `banner:`
// frontmatter keeps working.
import Default from '@astrojs/starlight/components/Banner.astro';
import VersionNoteText from './VersionNoteText.astro';
import { versionOf } from '../lib/version.mjs';

const { entry } = Astro.locals.starlightRoute;

const version = versionOf(entry.id);

// Only landing pages get the banner here; content pages use PageTitle's note.
const isLanding = entry.data.template === 'splash' || Boolean(entry.data.hero);

const showBanner = isLanding && Boolean(version);
const unreleased = version?.kind === 'unreleased';
---

{
  showBanner && (
    <div class:list={['version-banner', { unreleased }]}>
      <VersionNoteText version={version} id={entry.id} />
    </div>
  )
}
<Default>
  <slot />
</Default>

<style>
  .version-banner {
    box-shadow: var(--sl-shadow-sm);
    line-height: var(--sl-line-height-headings);
    padding: var(--sl-nav-pad-y) var(--sl-nav-pad-x);
    text-align: center;
    text-wrap: balance;
    background-color: var(--sl-color-blue-low);
    color: var(--sl-color-blue-high);
  }
  .version-banner.unreleased {
    background-color: var(--sl-color-orange-low);
    color: var(--sl-color-orange-high);
  }
  .version-banner :global(a),
  .version-banner :global(code) {
    color: inherit;
  }
  .version-banner :global(code) {
    background-color: transparent;
  }
</style>
