# Generated files, never edited by hand. linguist-generated collapses them in GitHub
# diffs; generated-by names the task that rebuilds them, and
# .claude/hooks/guard-generated-files.sh refuses hand edits with that name.
**/zz_generated.*.go                linguist-generated generated-by=generate
config/crd/bases/*.yaml             linguist-generated generated-by=manifests
config/rbac/role.yaml               linguist-generated generated-by=manifests
config/webhook/manifests.yaml       linguist-generated generated-by=manifests
helm/kube-image-keeper/crds/*.yaml  linguist-generated generated-by=manifests
helm/kube-image-keeper/files/*.yaml linguist-generated generated-by=manifests
helm/kube-image-keeper/README.md    linguist-generated generated-by=generate-helm-docs
PROJECT                             linguist-generated generated-by=kubebuilder
